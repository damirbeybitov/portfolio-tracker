# Database
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_secret
POSTGRES_DB=portfolio_tracker

# Backend
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALPHA_VANTAGE_API_KEY=твой_ключ
TWELVE_DATA_API_KEY=твой_ключ

# CORS
ALLOWED_ORIGINS=http://localhost:4200

# Environment
ENVIRONMENT=development

# ── Airflow ──────────────────────────────────────────────────────
# Separate metadata DB — do not reuse POSTGRES_* above for this.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_secret
AIRFLOW_DB_NAME=airflow

# On Linux, set this to your host UID so files written by Airflow
# containers (logs, etc.) aren't owned by root: run `id -u` and put
# the result here. Leave as-is on macOS/Windows Docker Desktop.
AIRFLOW_UID=50000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank for local dev (Airflow will run unencrypted-fernet, fine for local).
AIRFLOW_FERNET_KEY=

# Web UI login (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

AIRFLOW_TZ=UTC
